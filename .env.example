# Placeholders only — never a real key. This repository is public.
# Copy to `.env` for local development; Vercel reads the same names (no prefix) from
# project environment variables, not from this file. See .claude/rules/common/security.md.

# Server-only. Never prefix with VITE_ — VITE_* is inlined into the client bundle at build
# time, which would ship the key to the browser.
#
# Required for live generation (free-input mode) and for `vp run generate:passport` without
# `--offline`. Read by src/lib/ai-client.ts inside the handler, never at module scope.
#
# Gating is by presence, not a feature flag: if this is unset, the app runs cache-only —
# preset personas replay the committed cache in src/data/cache/, and free input refuses with
# a typed response instead of calling the gateway.
AI_GATEWAY_API_KEY=vck_your-vercel-ai-gateway-key-here

# Optional. Defaults to https://ai-gateway.vercel.sh (no trailing /v1) when unset — see
# src/lib/ai-client.ts's DEFAULT_BASE_URL. Set to https://api.anthropic.com only to bypass
# the gateway with a direct Anthropic key instead of a gateway key; a gateway key sent to
# api.anthropic.com gets a 401.
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
