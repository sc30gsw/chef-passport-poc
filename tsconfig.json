{
  "compilerOptions": {
    "target": "ES2022",
    /* ES2023 for the immutable array methods (`toSorted`) that react-doctor's
       js-tosorted-immutable rule requires in place of `[...arr].sort()`. Node 24 and every
       browser Vite targets support them. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    /* Strict */
    "strict": true,
    "libReplacement": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    /* Bundler mode */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* `scripts/` runs under plain Node, which requires explicit .ts specifiers */
    "allowImportingTsExtensions": true,

    /* No `baseUrl`: oxlint's TypeScript checker rejects it (tsgolint#351), so `paths`
       entries must be relative. `vite.config.ts` mirrors this in `resolve.alias`. */
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "scripts", "*.config.ts"]
}
